{
  "buildCommand": "node build.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/premixes.html",
      "destination": "/premixes/",
      "permanent": true
    },
    {
      "source": "/aquaculture.html",
      "destination": "/species/aquaculture/",
      "permanent": true
    },
    {
      "source": "/aquaculture",
      "destination": "/species/aquaculture/",
      "permanent": true
    },
    {
      "source": "/poultry.html",
      "destination": "/species/poultry/",
      "permanent": true
    },
    {
      "source": "/poultry",
      "destination": "/species/poultry/",
      "permanent": true
    },
    {
      "source": "/ruminant.html",
      "destination": "/species/ruminant/",
      "permanent": true
    },
    {
      "source": "/ruminant",
      "destination": "/species/ruminant/",
      "permanent": true
    },
    {
      "source": "/feed-additives.html",
      "destination": "/products/",
      "permanent": true
    },
    {
      "source": "/feed-additives",
      "destination": "/products/",
      "permanent": true
    },
    {
      "source": "/fr/aquaculture.html",
      "destination": "/fr/species/aquaculture/",
      "permanent": true
    },
    {
      "source": "/fr/aquaculture",
      "destination": "/fr/species/aquaculture/",
      "permanent": true
    },
    {
      "source": "/fr/poultry.html",
      "destination": "/fr/species/poultry/",
      "permanent": true
    },
    {
      "source": "/fr/poultry",
      "destination": "/fr/species/poultry/",
      "permanent": true
    },
    {
      "source": "/fr/ruminant.html",
      "destination": "/fr/species/ruminant/",
      "permanent": true
    },
    {
      "source": "/fr/ruminant",
      "destination": "/fr/species/ruminant/",
      "permanent": true
    },
    {
      "source": "/fr/feed-additives.html",
      "destination": "/fr/products/",
      "permanent": true
    },
    {
      "source": "/fr/feed-additives",
      "destination": "/fr/products/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Content-Language",
          "value": "en"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Content-Language",
          "value": "en"
        }
      ]
    },
    {
      "source": "/fr/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Language",
          "value": "fr"
        }
      ]
    },
    {
      "source": "/fr/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Language",
          "value": "fr"
        }
      ]
    },
    {
      "source": "/news/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/species/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/about/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/products/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/contact/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/certifications/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/premixes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
